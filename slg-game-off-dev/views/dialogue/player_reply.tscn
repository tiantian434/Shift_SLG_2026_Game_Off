[sub_resource type="Shader" id="PortraitMask"]
code = "shader_type canvas_item;

void fragment() {
	vec4 face = texture(TEXTURE, UV);
	vec2 p = (UV - vec2(0.5, 0.51)) / vec2(0.49, 0.48);
	float edge = length(p);
	float rim = smoothstep(0.94, 0.97, edge);
	COLOR = vec4(mix(face.rgb, vec3(0.99, 0.94, 0.81), rim), (1.0 - smoothstep(0.98, 1.0, edge)) * COLOR.a);
}"

