[gd_scene format=3]

[ext_resource type="Script" path="res://views/hud/task_drawer.gd" id="1_drawer"]

[node name="TaskDrawer" type="PanelContainer"]
theme_type_variation = &"TaskPaper"
script = ExtResource("1_drawer")

[node name="Contents" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 5

[node name="Header" type="HBoxContainer" parent="Contents"]
layout_mode = 2

[node name="Title" type="Label" parent="Contents/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DisplayLabel"
theme_override_colors/font_color = Color(0.227, 0.157, 0.105, 1)
theme_override_font_sizes/font_size = 16
text = "任务班表"

[node name="CloseTasks" type="Button" parent="Contents/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_type_variation = &"CloseBadge"
tooltip_text = "关闭任务班表"

[node name="Rule" type="HSeparator" parent="Contents"]
layout_mode = 2

[node name="TaskScroll" type="ScrollContainer" parent="Contents"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 0

[node name="TaskList" type="VBoxContainer" parent="Contents/TaskScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 5

[node name="EmptyTasks" type="Label" parent="Contents"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"InkLabel"
theme_override_font_sizes/font_size = 12
text = "班表上暂时没有事务。"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3
