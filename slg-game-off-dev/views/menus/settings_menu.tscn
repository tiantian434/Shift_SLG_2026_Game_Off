[gd_scene format=3]

[ext_resource type="Theme" path="res://views/hud/shift_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://views/menus/settings_menu.gd" id="2_script"]

[sub_resource type="StyleBoxFlat" id="SliderTrack"]
content_margin_top = 3.0
content_margin_bottom = 3.0
bg_color = Color(0.37, 0.255, 0.163, 1)

[sub_resource type="StyleBoxFlat" id="SliderFill"]
content_margin_top = 3.0
content_margin_bottom = 3.0
bg_color = Color(0.86, 0.527, 0.235, 1)

[sub_resource type="StyleBoxFlat" id="SliderFillHover"]
content_margin_top = 3.0
content_margin_bottom = 3.0
bg_color = Color(0.967, 0.672, 0.299, 1)

[sub_resource type="StyleBoxFlat" id="PaperToggle"]
content_margin_left = 9.0
content_margin_right = 9.0
bg_color = Color(0.828, 0.726, 0.535, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.609, 0.445, 0.27, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_left = 2
corner_radius_bottom_right = 2
anti_aliasing = false

[node name="SettingsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = ExtResource("2_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.112, 0.084, 0.071, 0.92)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(292, 0)
layout_mode = 2
theme_type_variation = &"PaperPanel"

[node name="Contents" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Center/Panel/Contents"]
layout_mode = 2
theme_type_variation = &"InkLabel"
theme_override_font_sizes/font_size = 23
text = "设置"

[node name="Rule" type="ColorRect" parent="Center/Panel/Contents"]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
mouse_filter = 2
color = Color(0.61, 0.445, 0.27, 1)

[node name="Volume" type="VBoxContainer" parent="Center/Panel/Contents"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="VolumeHeading" type="HBoxContainer" parent="Center/Panel/Contents/Volume"]
layout_mode = 2

[node name="VolumeLabel" type="Label" parent="Center/Panel/Contents/Volume/VolumeHeading"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"InkLabel"
text = "主音量"

[node name="VolumeValue" type="Label" parent="Center/Panel/Contents/Volume/VolumeHeading"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"InkLabel"
text = "100%"

[node name="MasterVolume" type="HSlider" parent="Center/Panel/Contents/Volume"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_styles/slider = SubResource("SliderTrack")
theme_override_styles/grabber_area = SubResource("SliderFill")
theme_override_styles/grabber_area_highlight = SubResource("SliderFillHover")
value = 100.0

[node name="Fullscreen" type="CheckButton" parent="Center/Panel/Contents"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(0.228, 0.147, 0.084, 1)
theme_override_colors/font_focus_color = Color(0.228, 0.147, 0.084, 1)
theme_override_colors/font_hover_color = Color(0.35, 0.19, 0.092, 1)
theme_override_colors/font_pressed_color = Color(0.228, 0.147, 0.084, 1)
theme_override_colors/font_hover_pressed_color = Color(0.35, 0.19, 0.092, 1)
theme_override_styles/normal = SubResource("PaperToggle")
theme_override_styles/hover = SubResource("PaperToggle")
theme_override_styles/pressed = SubResource("PaperToggle")
theme_override_styles/hover_pressed = SubResource("PaperToggle")
text = "全屏显示"

[node name="Display" type="VBoxContainer" parent="Center/Panel/Contents"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="WindowResolutionRow" type="HBoxContainer" parent="Center/Panel/Contents/Display"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="WindowResolutionLabel" type="Label" parent="Center/Panel/Contents/Display/WindowResolutionRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"InkLabel"
text = "窗口分辨率"

[node name="WindowResolution" type="OptionButton" parent="Center/Panel/Contents/Display/WindowResolutionRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 28)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_type_variation = &"PaperButton"
tooltip_text = "切换游戏窗口的像素尺寸"

[node name="OutputResolution" type="Label" parent="Center/Panel/Contents/Display"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"InkLabel"
theme_override_font_sizes/font_size = 11
text = "当前窗口  1280 × 720"
horizontal_alignment = 2

[node name="DisplayHint" type="Label" parent="Center/Panel/Contents/Display"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"InkLabel"
theme_override_font_sizes/font_size = 11
text = "内嵌窗口由 Godot 编辑器控制。关闭「下次运行时嵌入游戏」，重新运行后可在此切换分辨率。"
autowrap_mode = 2

[node name="Back" type="Button" parent="Center/Panel/Contents"]
unique_name_in_owner = true
custom_minimum_size = Vector2(92, 34)
layout_mode = 2
size_flags_horizontal = 8
mouse_default_cursor_shape = 2
theme_type_variation = &"PaperButton"
text = "返回"
